{
  "manifest_version": 3,
  "name": "Medicus Suite",
  "version": "4.0.0",
  "description": "Workflow and display on the Medicus session. Does not make a clinical judgement, recommendation or calculation.",
  "permissions": [
    "storage",
    "scripting",
    "sidePanel",
    "tabs",
    "alarms",
    "notifications",
    "windows",
    "idle"
  ],
  "host_permissions": [
    "https://*.medicus.health/*",
    "https://*.api.england.medicus.health/*",
    "https://api.github.com/repos/davetriska02-collab/medicus-suite-public/*",
    "https://api.nhs.uk/*",
    "https://termbrowser.nhs.uk/*",
    "https://*.supabase.co/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-src 'self' https://www.youtube-nocookie.com"
  },
  "side_panel": {
    "default_path": "side-panel/panel.html"
  },
  "action": {
    "default_title": "Medicus Suite",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.medicus.health/*"
      ],
      "js": [
        "content-scripts/triage-lens/page-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.medicus.health/*"
      ],
      "js": [
        "shared/dom-contracts.js",
        "content-scripts/dom-observer-hub.js",
        "shared/injector-runtime.js",
        "shared/contract-canary.js",
        "content-scripts/pusher-relay.js",
        "engine/extractors/patient-context.js",
        "engine/extractors/medications.js",
        "engine/extractors/observations.js",
        "engine/extractors/problems.js",
        "engine/api-client.js",
        "engine/normalisers.js",
        "engine/ruleset-io.js",
        "shared/extraction-health.js",
        "shared/event-ledger.js",
        "shared/journal-observations.js",
        "content-scripts/referrals-discovery.js",
        "content-scripts/api-discovery.js",
        "shared/patient-alerts-lookup.js",
        "content-scripts/patient-alerts-banner.js"
      ],
      "css": [
        "content-scripts/patient-alerts-banner.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.medicus.health/*"
      ],
      "js": [
        "content-scripts/triage-lens/rule-match.js",
        "engine/reception-match.js",
        "shared/pending-result-index.js",
        "shared/contact-ledger.js",
        "content-scripts/triage-lens/queue-pulse.js",
        "shared/practice-packs.js",
        "content-scripts/triage-lens/content.js",
        "content-scripts/triage-lens/routine-rx-button.js",
        "shared/investigation-results-view.js"
      ],
      "css": [
        "content-scripts/triage-lens/hud.css",
        "content-scripts/triage-lens/routine-rx-button.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.medicus.health/*"
      ],
      "js": [
        "shared/due-mini.js",
        "shared/companion-role.js",
        "shared/outstanding-investigations.js",
        "shared/investigation-results-view.js",
        "shared/write-core.js",
        "shared/companion-write-core.js",
        "content-scripts/task-actions-panel.js",
        "shared/quick-actions-core.js",
        "content-scripts/reception-quick-actions.js",
        "content-scripts/document-codes-to-problems.js",
        "shared/legacy-coded-description.js",
        "shared/coding-specificity.js",
        "shared/snomed-retirement.js",
        "shared/preferred-descriptions.js",
        "shared/problem-text-linking.js",
        "shared/journal-problem-matching.js",
        "shared/tidy-write-core.js",
        "content-scripts/problem-description-cleanup.js",
        "shared/appointment-organise-core.js",
        "content-scripts/appointment-organise-canvas.js",
        "shared/lab-allocate-core.js",
        "shared/allocation-groups-core.js",
        "shared/allocation-dest-strip.js",
        "content-scripts/lab-allocate-canvas.js",
        "shared/workflow-allocate-core.js",
        "content-scripts/workflow-allocate-canvas.js",
        "shared/rx-allocate-core.js",
        "content-scripts/rx-allocate-canvas.js",
        "shared/request-allocate-core.js",
        "content-scripts/request-allocate-canvas.js",
        "content-scripts/allergy-cleanup.js",
        "content-scripts/allergy-cleanup-canvas.js",
        "shared/presence-look.js",
        "content-scripts/task-presence.js",
        "content-scripts/task-bulk-action.js",
        "content-scripts/privacy-officer-bulk-acknowledge.js",
        "content-scripts/eps-cancellation-bulk-discard.js",
        "shared/template-organiser-core.js",
        "shared/template-organiser-client.js",
        "content-scripts/template-organiser/template-organiser-canvas.js",
        "shared/workload-tracker-core.js",
        "content-scripts/workload-tracker.js"
      ],
      "css": [
        "content-scripts/task-actions-panel.css",
        "content-scripts/reception-quick-actions.css",
        "content-scripts/document-codes-to-problems.css",
        "content-scripts/problem-description-cleanup.css",
        "content-scripts/appointment-organise-canvas.css",
        "content-scripts/lab-allocate-canvas.css",
        "content-scripts/allergy-cleanup.css",
        "content-scripts/allergy-cleanup-canvas.css",
        "content-scripts/task-presence.css",
        "content-scripts/task-bulk-action.css",
        "content-scripts/template-organiser/template-organiser-canvas.css",
        "content-scripts/workload-tracker.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.medicus.health/*"
      ],
      "js": [
        "engine/contact-relationships.js",
        "engine/name-derivations.js",
        "engine/contact-match.js",
        "engine/contact-tree.js",
        "content-scripts/contacts-api.js",
        "content-scripts/contacts-canvas.js",
        "content-scripts/contacts-link-button.js"
      ],
      "css": [
        "content-scripts/contacts-canvas.css",
        "content-scripts/contacts-link-button.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "rules/reception-pathways.json",
        "rules/non-problem-root-codes.json",
        "rules/snomed-terminology-server.json",
        "rules/generic-additional-info-text.json",
        "rules/contact-relationships.json",
        "rules/allergy-junk-codes.json",
        "rules/allergy-substance-conversion.json",
        "shared/booking-core.js"
      ],
      "matches": [
        "https://*.medicus.health/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
